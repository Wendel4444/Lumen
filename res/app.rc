#include <winver.h>

1 ICON "lumen.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "Lumen"
            VALUE "FileDescription", "Lumen - biblioteca visual de jogos"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "Lumen"
            VALUE "OriginalFilename", "Lumen.exe"
            VALUE "ProductName", "Lumen"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
